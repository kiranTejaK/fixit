# Copy this file to .env and fill in your actual values.
# Never commit the real .env file to version control.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/fixit_db

# Flask secret key — used to sign session cookies and flash messages.
# Generate a strong random key for production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Flask environment: "development" or "production"
FLASK_ENV=development
